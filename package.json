{
  "name": "appcenter",
  "productName": "AppCenter",
  "version": "1.1.0",
  "description": "AppCenter - Un hub centralizado de aplicaciones web con soporte para notificaciones y modo concentración",
  "main": "main.js",
  "author": "Dobuss",
  "repository": {
    "type": "git",
    "url": "https://github.com/mapiedra-hexer/appCenter.git"
  },
  "scripts": {
    "start": "electron .",
    "prepare": "node scripts/install-git-hooks.cjs",
    "version:bump": "node scripts/bump-version.cjs",
    "build": "electron-builder --win nsis --publish never",
    "build:all": "electron-builder --win --linux --mac --publish never",
    "build:win": "electron-builder --win nsis --publish never",
    "build:win:portable": "electron-builder --win portable --publish never",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "es.dobuss.appcenter",
    "productName": "AppCenter",
    "copyright": "© 2025 Dobuss",
    "icon": "src/assets/icons/appcenter.png",
    "publish": [
      {
        "provider": "github",
        "owner": "mapiedra-hexer",
        "repo": "appCenter",
        "publishAutoUpdate": false
      }
    ],
    "files": [
      "main.js",
      "store.js",
      "src/**/*",
      "node_modules/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*"
    ],
    "extraResources": [
      {
        "from": "src/assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icons/appcenter.ico",
      "signAndEditExecutable": false,
      "sign": null,
      "signingHashAlgorithms": null
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icons/appcenter.png",
      "category": "Utility"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "src/assets/icons/appcenter.png",
      "category": "public.app-category.productivity"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "src/assets/icons/appcenter.ico",
      "uninstallerIcon": "src/assets/icons/appcenter.ico"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "simple-icons": "^16.11.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "electron": "^40.9.2",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.1",
    "semantic-release": "^24.2.3"
  }
}
